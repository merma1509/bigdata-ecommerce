{
  "collections": [
    {
      "name": "categories",
      "schema": {
        "bsonType": "object",
        "properties": {
          "_id": {"bsonType": "objectId"},
          "category_id": {"bsonType": "long"},
          "category_code": {"bsonType": "string"},
          "category_name": {"bsonType": "string"},
          "created_at": {"bsonType": "date"},
          "updated_at": {"bsonType": "date"}
        },
        "required": ["category_id"]
      }
    },
    {
      "name": "products",
      "schema": {
        "bsonType": "object",
        "properties": {
          "_id": {"bsonType": "objectId"},
          "product_id": {"bsonType": "long"},
          "category_id": {"bsonType": ["long", "null"]},
          "brand": {"bsonType": ["string", "null"]},
          "price": {"bsonType": ["decimal", "null"]},
          "created_at": {"bsonType": "date"},
          "updated_at": {"bsonType": "date"}
        },
        "required": ["product_id"]
      }
    },
    {
      "name": "users",
      "schema": {
        "bsonType": "object",
        "properties": {
          "_id": {"bsonType": "objectId"},
          "user_id": {"bsonType": "long"},
          "user_device_id": {"bsonType": ["string", "null"]},
          "client_id": {"bsonType": "string"},
          "created_at": {"bsonType": "date"},
          "updated_at": {"bsonType": "date"}
        },
        "required": ["user_id", "client_id"]
      }
    },
    {
      "name": "campaigns",
      "schema": {
        "bsonType": "object",
        "properties": {
          "_id": {"bsonType": "objectId"},
          "id": {"bsonType": "int"},
          "campaign_type": {"bsonType": ["string", "null"]},
          "channel": {"bsonType": ["string", "null"]},
          "topic": {"bsonType": ["string", "null"]},
          "started_at": {"bsonType": ["date", "null"]},
          "finished_at": {"bsonType": ["date", "null"]},
          "created_at": {"bsonType": "date"},
          "updated_at": {"bsonType": "date"}
        },
        "required": ["id"]
      }
    },
    {
      "name": "events",
      "schema": {
        "bsonType": "object",
        "properties": {
          "_id": {"bsonType": "objectId"},
          "event_id": {"bsonType": "long"},
          "user_id": {"bsonType": "long"},
          "product_id": {"bsonType": ["long", "null"]},
          "event_type": {"bsonType": "string"},
          "price": {"bsonType": ["decimal", "null"]},
          "user_session": {"bsonType": ["string", "null"]},
          "event_time": {"bsonType": "date"},
          "created_at": {"bsonType": "date"}
        },
        "required": ["event_id", "user_id", "event_type", "event_time"]
      }
    },
    {
      "name": "friends",
      "schema": {
        "bsonType": "object",
        "properties": {
          "_id": {"bsonType": "objectId"},
          "friendship_id": {"bsonType": "long"},
          "user_id": {"bsonType": "long"},
          "friend_id": {"bsonType": "long"},
          "created_at": {"bsonType": "date"}
        },
        "required": ["friendship_id", "user_id", "friend_id"]
      }
    },
    {
      "name": "messages",
      "schema": {
        "bsonType": "object",
        "properties": {
          "_id": {"bsonType": "objectId"},
          "message_id": {"bsonType": "long"},
          "campaign_id": {"bsonType": ["int", "null"]},
          "user_id": {"bsonType": "long"},
          "category": {"bsonType": ["string", "null"]},
          "platform": {"bsonType": ["string", "null"]},
          "is_opened": {"bsonType": "bool"},
          "is_clicked": {"bsonType": "bool"},
          "is_purchased": {"bsonType": "bool"},
          "sent_at": {"bsonType": ["date", "null"]},
          "created_at": {"bsonType": "date"},
          "updated_at": {"bsonType": "date"}
        },
        "required": ["message_id", "user_id"]
      }
    }
  ]
}
